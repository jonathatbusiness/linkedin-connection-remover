{
  "manifest_version": 3,
  "name": "LinkedIn Connection Remover",
  "version": "0.1.0",
  "description": "Remove conexões do LinkedIn a partir de uma lista, com confirmação, pausa e parada.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mostrar/ocultar Connection Remover"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/mynetwork/invite-connect/connections/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
